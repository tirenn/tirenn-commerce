# ==============================================================================
# Tirenn Commerce - Infrastructure Environment Configuration (.env.example)
# ==============================================================================

# PostgreSQL Database Configuration
POSTGRES_USER=postgres_user111
POSTGRES_PASSWORD=password123!!!
POSTGRES_DB=commerce_db
POSTGRES_PORT=5432

# Redis In-Memory Store
REDIS_PORT=6379

# Ollama LLM Port & Models
OLLAMA_PORT=11434
OLLAMA_CHAT_MODEL=qwen3.5:4b
OLLAMA_EMBED_MODEL=bge-m3

# Ollama Runtime Settings (RAM optimization for VPS)
OLLAMA_NUM_PARALLEL=1
OLLAMA_MAX_LOADED_MODELS=1
OLLAMA_KEEP_ALIVE=30m

# Grafana Loki & Promtail
LOKI_PORT=3100

# Grafana Visual Dashboard Credentials
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=admin
GF_USERS_ALLOW_SIGN_UP=false
GRAFANA_PORT=3001
