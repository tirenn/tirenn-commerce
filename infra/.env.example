# PostgreSQL Database Configuration
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
POSTGRES_PORT=5432

# Redis In-Memory Store
REDIS_PORT=6379

# Ollama LLM Port
OLLAMA_PORT=11434

# Grafana Loki & Promtail
LOKI_PORT=3100

# Grafana Visual Dashboard Credentials
GF_SECURITY_ADMIN_USER=
GF_SECURITY_ADMIN_PASSWORD=
GF_USERS_ALLOW_SIGN_UP=false
GRAFANA_PORT=3001
