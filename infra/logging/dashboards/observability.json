      "gridPos": { "h": 7, "w": 8, "x": 16, "y": 1 },
      "id": 3,
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["sum"] },
        "tooltip": { "mode": "multi" }
      },
      "title": "🚨 Error & Warning Frequency (Count)",
      "type": "timeseries",
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "Loki" },
          "editorMode": "code",
          "expr": "sum by (service) (count_over_time({container=~\"tirenn-.+\"} |= \"ERROR\" [$__interval]))",
          "legendFormat": "ERROR: {{service}}",
          "queryType": "range",
          "refId": "A"
        },
        {
          "datasource": { "type": "loki", "uid": "Loki" },
          "editorMode": "code",
          "expr": "sum by (service) (count_over_time({container=~\"tirenn-.+\"} |= \"WARN\" [$__interval]))",
