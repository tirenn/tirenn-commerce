# ------------------------------------------------------------------------------
# Tirenn AI Commerce & Shopper Service - Environment Configuration
# ------------------------------------------------------------------------------

# Service Server Settings
SERVICE_NAME="Tirenn AI Commerce & Shopper Service"
HOST="0.0.0.0"
PORT=8000
ENVIRONMENT="development"

# PostgreSQL Database with pgvector & pg_trgm (Direct DB Option 1)
DB_HOST="postgres"
DB_PORT=5432
DB_USER="gouser"
DB_PASSWORD="gopassword"
DB_NAME="gocommerce_db"

# Redis In-Memory Store (Distributed Sliding Window Rate Limiting)
REDIS_HOST="redis"
REDIS_PORT=6379
REDIS_PASSWORD=""
REDIS_DB=0

# Core Go Backend API URL
BACKEND_API_URL="http://backend:8080/api/v1"

# Ollama LLM Configuration (Qwen 2.5)
OLLAMA_BASE_URL="http://ollama:11434"
LLM_MODEL="qwen2.5:3b"

# LLM Temperature Settings
LLM_TOOL_TEMPERATURE=0.0
LLM_CHAT_TEMPERATURE=0.3

# Embedding Model (HuggingFace Sentence Transformers)
EMBEDDING_MODEL_NAME="sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2"

# Similarity Thresholds (0.0 to 1.0)
DEFAULT_SEARCH_SCORE_THRESHOLD=0.30
CHAT_SEARCH_SCORE_THRESHOLD=0.25
CHAT_SEARCH_FALLBACK_THRESHOLD=0.15


# Hybrid Search: Dense Vector + PostgreSQL Trigram Keyword Matching
ENABLE_HYBRID_SEARCH=true
HYBRID_VECTOR_WEIGHT=0.70
HYBRID_TEXT_WEIGHT=0.30

# Search Limits
SEARCH_LIMIT=12
CHAT_SEARCH_LIMIT=10

# ------------------------------------------------------------------------------
# API Security Configurations
# ------------------------------------------------------------------------------

# CORS Allowed Origins
CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000,*"

# IP Rate Limiting (Sliding Window backed by Redis)
RATE_LIMIT_ENABLED=true
RATE_LIMIT_GENERAL_PER_MINUTE=60
RATE_LIMIT_CHAT_PER_MINUTE=30

# Maximum Allowed Request Body Size (2MB)
MAX_REQUEST_BODY_BYTES=2097152

# Optional Internal API Key
INTERNAL_API_KEY=""
