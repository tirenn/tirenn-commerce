# ==============================================================================
# Tirenn Commerce Backend - Environment Configuration Template (.env.example)
# ==============================================================================

# Server Settings
PORT=8080
ENVIRONMENT=development
AI_SERVICE_URL=http://ai-service:8000

# PostgreSQL Database Connection (pgvector enabled)
DB_HOST=postgres
DB_PORT=5432
DB_USER=postgres_user111
DB_PASSWORD=password123!!!
DB_NAME=commerce_db

# Redis In-Memory Cache & Rate Limiting
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS_PER_MINUTE=600
RATE_LIMIT_WINDOW_SECONDS=60

# JWT Authentication & Security
JWT_SECRET=super-secret-tirenn-jwt-key-2026
JWT_EXPIRE_HOURS=24
JWT_ISSUER=commerce-api
INTERNAL_API_KEY=very-very-secret-internal-key-2026

# AI Semantic Search & Hybrid Settings
DEFAULT_SEARCH_SCORE_THRESHOLD=0.38
CHAT_SEARCH_SCORE_THRESHOLD=0.30
CHAT_SEARCH_FALLBACK_THRESHOLD=0.20
ENABLE_HYBRID_SEARCH=true
HYBRID_VECTOR_WEIGHT=0.70
HYBRID_TEXT_WEIGHT=0.30
SEARCH_LIMIT=12
CHAT_SEARCH_LIMIT=6
