# Tirenn Commerce Frontend Environment Variables
# In Vite, all client-exposed environment variables must start with VITE_

# Backend API Base URL (including /api/v1)
VITE_API_BASE_URL=http://localhost:8080/api/v1

# Alternatively, Root Backend URL
VITE_BACKEND_URL=http://localhost:8080

# AI Microservice Base URL (for Chat Shopper and AI embeddings)
VITE_AI_SERVICE_URL=http://localhost:8000/api/v1

