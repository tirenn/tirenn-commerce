# ==============================================================================
# Tirenn Commerce Frontend - Environment Configuration Template (.env.example)
# ==============================================================================
# In Vite, all client-exposed environment variables must start with VITE_

# Core Backend REST API Base URL
VITE_API_BASE_URL=
VITE_BACKEND_URL=

# AI Microservice Base URL (Semantic Search & Real-Time Shopping Assistant)
VITE_AI_SERVICE_URL=

# ------------------------------------------------------------------------------
# Currency Exchange Rate & Multi-Currency Configuration
# ------------------------------------------------------------------------------
# Free Real-Time Exchange Rate API Endpoint (e.g. open.er-api.com, exchangerate-api.com)
VITE_EXCHANGE_RATE_API_URL=https://open.er-api.com/v6/latest/USD

# Fallback Exchange Rate if external API is unreachable (1 USD = X IDR)
VITE_DEFAULT_EXCHANGE_RATE=16000.0

# Rate Cache Duration in Minutes (stored in localStorage)
VITE_EXCHANGE_RATE_CACHE_MINUTES=60

# Default Fallback Currency ("IDR" or "USD")
VITE_DEFAULT_CURRENCY=IDR

# ------------------------------------------------------------------------------
# Storefront Catalog & Infinite Scroll Settings
# ------------------------------------------------------------------------------
# Number of products loaded per pagination scroll batch
VITE_PRODUCTS_PER_PAGE=12
