# ==============================================================================
# Tirenn Commerce Backend - Environment Configuration Template (.env.example)
# ==============================================================================

# Server Settings
PORT=8080
ENVIRONMENT=development
AI_SERVICE_URL=

# PostgreSQL Database Connection (pgvector enabled)
DB_HOST=
DB_PORT=5432
DB_USER=
DB_PASSWORD=
DB_NAME=

# Redis In-Memory Cache & Rate Limiting
REDIS_HOST=
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
RATE_LIMIT_REQUESTS_PER_MINUTE=120
RATE_LIMIT_WINDOW_SECONDS=60

# JWT Authentication & Security
JWT_SECRET=
JWT_EXPIRE_HOURS=24
JWT_ISSUER=gocommerce-api
INTERNAL_API_KEY=
