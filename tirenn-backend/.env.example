# ==============================================================================
# Tirenn Commerce Backend - Environment Configuration Template (.env.example)
# ==============================================================================

# Server Settings
PORT=8080
ENVIRONMENT=development
AI_SERVICE_URL=http://localhost:8000

# PostgreSQL Database Connection (pgvector enabled)
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=gouser
DB_PASSWORD=gopassword
DB_NAME=gocommerce_db

# Redis In-Memory Cache & Rate Limiting
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
RATE_LIMIT_REQUESTS_PER_MINUTE=120
RATE_LIMIT_WINDOW_SECONDS=60

# JWT Authentication & Security
JWT_SECRET=super-secret-tirenn-jwt-key-2026
JWT_EXPIRE_HOURS=24
JWT_ISSUER=gocommerce-api
