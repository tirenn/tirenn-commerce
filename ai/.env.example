# ==============================================================================
# Tirenn AI Commerce & Shopper Service - Environment Example (.env.example)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Server & Service Settings
# ------------------------------------------------------------------------------
SERVICE_NAME="Tirenn AI Commerce & Shopper Service"
HOST="0.0.0.0"
PORT=8000
ENVIRONMENT="development"

# ------------------------------------------------------------------------------
# 2. Database Connection (PostgreSQL + pgvector + pg_trgm)
# ------------------------------------------------------------------------------
DB_HOST=postgres
DB_PORT=5432
DB_USER=postgres_user111
DB_PASSWORD=password123!!!
DB_NAME=commerce_db

# ------------------------------------------------------------------------------
# 3. Redis In-Memory Store (Session, Rate Limiting & RAG Cache)
# ------------------------------------------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=""
REDIS_DB=0

# ------------------------------------------------------------------------------
# 4. Backend Go Service Integration
# ------------------------------------------------------------------------------
BACKEND_API_URL="http://backend:8080/api/v1"

# ------------------------------------------------------------------------------
# 5. Ollama LLM & Embedding Settings
# ------------------------------------------------------------------------------
OLLAMA_BASE_URL="http://ollama:11434"
LLM_MODEL="qwen3.5:4b"
EMBEDDING_MODEL_NAME="bge-m3"
EMBEDDING_DIMENSIONS=1024

# LLM Generation & Inference Performance Parameters
LLM_NUM_PREDICT=350
LLM_NUM_CTX=2048
LLM_KEEP_ALIVE="60m"
LLM_TIMEOUT=120.0
MAX_AGENT_ITERATIONS=5

# LLM Temperature Settings
LLM_TOOL_TEMPERATURE=0.0
LLM_CHAT_TEMPERATURE=0.3

# ------------------------------------------------------------------------------
# 6. Similarity Thresholds (0.0 to 1.0)
# ------------------------------------------------------------------------------
DEFAULT_SEARCH_SCORE_THRESHOLD=0.38
CHAT_SEARCH_SCORE_THRESHOLD=0.30
CHAT_SEARCH_FALLBACK_THRESHOLD=0.20
RECOMMENDATION_SIMILARITY_THRESHOLD=0.35

# ------------------------------------------------------------------------------
# 7. Hybrid Search Weights (Dense Vector + PostgreSQL Trigram Keyword)
# ------------------------------------------------------------------------------
ENABLE_HYBRID_SEARCH=true
HYBRID_VECTOR_WEIGHT=0.70
HYBRID_TEXT_WEIGHT=0.30

# ------------------------------------------------------------------------------
# 8. Result Limits
# ------------------------------------------------------------------------------
SEARCH_LIMIT=12
CHAT_SEARCH_LIMIT=6
RECOMMENDATIONS_LIMIT=6

# ------------------------------------------------------------------------------
# 9. Session & Sliding Window Memory (Redis List)
# ------------------------------------------------------------------------------
SESSION_HISTORY_LIMIT=10
SESSION_MAX_STORED=50
SESSION_TTL_SECONDS=86400

# ------------------------------------------------------------------------------
# 10. Redis RAG Semantic Cache
# ------------------------------------------------------------------------------
RAG_CACHE_ENABLED=true
RAG_CACHE_SEMANTIC_THRESHOLD=0.92
RAG_CACHE_TTL_SECONDS=86400
RAG_CACHE_MAX_ENTRIES=100

# ------------------------------------------------------------------------------
# 10.1. Redis LLM Response Semantic Cache (GPTCache Pattern)
# ------------------------------------------------------------------------------
LLM_CACHE_ENABLED=true
LLM_CACHE_SEMANTIC_THRESHOLD=0.92
LLM_CACHE_EXACT_TTL_SECONDS=7200
LLM_CACHE_SEMANTIC_TTL_SECONDS=7200
LLM_CACHE_MAX_ENTRIES=500

# ------------------------------------------------------------------------------
# 11. Security, Rate Limiting & Auth
# ------------------------------------------------------------------------------
CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000,*"
RATE_LIMIT_ENABLED=true
RATE_LIMIT_GENERAL_PER_MINUTE=300
RATE_LIMIT_CHAT_PER_MINUTE=180
MAX_REQUEST_BODY_BYTES=10485760

JWT_SECRET="super-secret-tirenn-jwt-key-2026"
JWT_ISSUER="commerce-api"
INTERNAL_API_KEY="very-very-secret-internal-key-2026"
