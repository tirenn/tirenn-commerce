# ------------------------------------------------------------------------------
# Tirenn AI Commerce & Shopper Service - Environment Configuration (.env.example)
# ------------------------------------------------------------------------------

# Service Server Settings
SERVICE_NAME="Tirenn AI Commerce & Shopper Service"
HOST="0.0.0.0"
PORT=8000
ENVIRONMENT="development"

# PostgreSQL Database with pgvector & pg_trgm
DB_HOST=
DB_PORT=5432
DB_USER=
DB_PASSWORD=
DB_NAME=

# Redis In-Memory Store
REDIS_HOST=
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Core Go Backend API URL
BACKEND_API_URL=

# Ollama LLM Configuration
OLLAMA_BASE_URL=
LLM_MODEL=

# LLM Temperature Settings
LLM_TOOL_TEMPERATURE=0.0
LLM_CHAT_TEMPERATURE=0.3

# Embedding Model (Ollama Embeddings e.g. bge-m3, paraphrase-multilingual, nomic-embed-text)
EMBEDDING_MODEL_NAME="bge-m3"

# Similarity Thresholds (0.0 to 1.0)
DEFAULT_SEARCH_SCORE_THRESHOLD=0.25
CHAT_SEARCH_SCORE_THRESHOLD=0.20
CHAT_SEARCH_FALLBACK_THRESHOLD=0.10

# Hybrid Search: Dense Vector + PostgreSQL Trigram Keyword Matching
ENABLE_HYBRID_SEARCH=true
HYBRID_VECTOR_WEIGHT=0.70
HYBRID_TEXT_WEIGHT=0.30

# Search Limits
SEARCH_LIMIT=12
CHAT_SEARCH_LIMIT=10

# ------------------------------------------------------------------------------
# API Security Configurations
# ------------------------------------------------------------------------------

# CORS Allowed Origins
CORS_ORIGINS=

# IP Rate Limiting (Sliding Window backed by Redis)
RATE_LIMIT_ENABLED=true
RATE_LIMIT_GENERAL_PER_MINUTE=300
RATE_LIMIT_CHAT_PER_MINUTE=180

# Maximum Allowed Request Body Size (10MB for PDF uploads)
MAX_REQUEST_BODY_BYTES=10485760

# JWT Secret Key (Synchronized with Backend)
JWT_SECRET=
JWT_ISSUER=
INTERNAL_API_KEY=
